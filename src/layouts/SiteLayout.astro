---
import { siteConfig } from "../data/site";
import { stringifyStructuredData, toAbsoluteUrl } from "../lib/seo";

interface Props {
  title?: string;
  description?: string;
  pageClass?: string;
  hideFooter?: boolean;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: string;
  publishedTime?: string;
  structuredData?: object | object[];
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  pageClass = "",
  hideFooter = false,
  ogImage = siteConfig.defaultSocialImage,
  ogImageAlt = siteConfig.defaultSocialImageAlt,
  ogType = "website",
  publishedTime,
  structuredData,
} = Astro.props;

const isHome = Astro.url.pathname === "/";
const canonicalUrl = new URL(Astro.url.pathname, siteConfig.siteUrl).toString();
const socialImageUrl = toAbsoluteUrl(ogImage);
const structuredDataJson = stringifyStructuredData(structuredData);
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content={siteConfig.title} />
    <meta name="robots" content="index,follow" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={siteConfig.siteName} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:alt" content={ogImageAlt} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {publishedTime && <meta property="article:author" content={siteConfig.title} />}
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="theme-color" content="#f4efe4" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400..600;1,6..72,400..500&family=Public+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/styles/global.css?v=20261010a" />
    {structuredDataJson && (
      <script type="application/ld+json" set:html={structuredDataJson}></script>
    )}
    <script is:inline>
      (() => {
        const stored = localStorage.getItem("theme");
        const preferred = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        document.documentElement.dataset.theme = stored || preferred;
      })();
    </script>
  </head>
  <body class={pageClass}>
    <div class={`page-shell ${isHome ? "page-home" : ""} ${pageClass}`.trim()}>
      <header class="site-header">
        <a class="brand" href="/" aria-label={`${siteConfig.title} — Home`}>
          <strong>Dylan H.</strong><span class="brand-place">Lancaster, SC</span>
        </a>

        <nav class="site-nav" aria-label="Primary">
          <a href="/photos/">Observing log</a>
          <a href="/posts/">Writing</a>
        </nav>

        <button class="theme-toggle" type="button" data-theme-toggle aria-label="Toggle color theme">
          <span data-theme-toggle-label>Light</span>
        </button>
      </header>

      <main>
        <slot />
      </main>

      {!hideFooter && (
        <footer class="site-footer">
          <p>Dylan H. Lancaster, South Carolina. Photos and writing are mine unless noted.</p>
          <div class="footer-links">
            <a href={`mailto:${siteConfig.email}`}>Email</a>
            <a href="https://github.com/dilllxd" rel="me">GitHub</a>
            <a href="https://status.dylan.lol" rel="me">Status</a>
          </div>
        </footer>
      )}
    </div>
    <script type="module" src="/scripts/theme-toggle.js"></script>
  </body>
</html>
