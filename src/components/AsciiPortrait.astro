---
import portrait from "../data/ascii-portrait.json";

const SEG = 5;
const esc = (s: string) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const grid = (rows: string[]) =>
  rows
    .map((row) => {
      const parts: string[] = [];
      for (let i = 0; i < row.length; i += SEG) parts.push(`<span class="ap-seg">${esc(row.slice(i, i + SEG))}</span>`);
      return parts.join("");
    })
    .join("\n");

const { cols, rows, ramp } = portrait;
---
<figure class="ap" data-ascii-portrait data-cols={cols} data-rows={rows} data-ramp={ramp} role="img" aria-label="ASCII portrait of Dylan with Amber, a tortoiseshell cat, leaning against his chest">
  <div class="ap-fit" style={`--cols:${cols}`}>
    <pre class="ap-grid ap-dark" data-mode="dark" aria-hidden="true" set:html={grid(portrait.dark)} />
    <pre class="ap-grid ap-light" data-mode="light" aria-hidden="true" set:html={grid(portrait.light)} />
  </div>
</figure>

<script>
  const fig = document.querySelector<HTMLElement>("[data-ascii-portrait]");
  if (fig) initPortrait(fig);

  function initPortrait(fig: HTMLElement) {
    const COLS = Number(fig.dataset.cols);
    const ROWS = Number(fig.dataset.rows);
    const SEG = 5;
    const ramp = fig.dataset.ramp || "";
    const idx = new Map<string, number>();
    [...ramp].forEach((c, i) => idx.set(c, i));
    const maxIdx = ramp.length - 1;
    const RADIUS = 10; // in column widths (cells are twice as tall as wide)
    const AMP = 4; // ramp steps at the centre
    const DECAY = 650; // ms for pointer energy to fade after the last move
    const WAVE_MS = 900;

    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
    const segsPerRow = Math.ceil(COLS / SEG);
    type Seg = { el: HTMLElement; base: string; cur: string; level: number };
    let grid: Seg[] = [];
    let pre: HTMLElement | null = null;

    const activePre = () => [...fig.querySelectorAll<HTMLElement>(".ap-grid")].find((p) => p.offsetParent !== null) || null;
    function build() {
      pre = activePre();
      grid = [];
      if (!pre) return;
      pre.querySelectorAll<HTMLElement>(".ap-seg").forEach((el) => {
        const base = el.textContent || "";
        grid.push({ el, base, cur: base, level: 0 });
      });
    }

    let visible = false, hidden = document.hidden, enabled = false;
    let px = 0, py = 0, lastMove = 0, inside = false, raf = 0;
    let waves: { x: number; y: number; t0: number }[] = [];
    let dirty = new Set<number>();
    let rect: DOMRect | null = null;

    function restore(i: number) {
      const s = grid[i];
      if (!s) return;
      if (s.cur !== s.base) { s.el.textContent = s.base; s.cur = s.base; }
      if (s.level) { s.el.classList.remove("h1", "h2"); s.level = 0; }
    }
    function restoreAll() { dirty.forEach(restore); dirty.clear(); }

    function frame(now: number) {
      raf = 0;
      if (!enabled || !visible || hidden || !rect || !pre) { restoreAll(); return; }
      const cw = rect.width / COLS, ch = rect.height / ROWS;
      const energy = inside ? Math.max(0, 1 - (now - lastMove) / DECAY) : 0;
      waves = waves.filter((w) => now - w.t0 < WAVE_MS);
      if (energy <= 0 && !waves.length) { restoreAll(); return; }
      const sources: { cx: number; cy: number; k: number; phase: number }[] = [];
      if (energy > 0) sources.push({ cx: (px - rect.left) / cw, cy: (py - rect.top) / ch, k: energy, phase: now / 110 });
      for (const w of waves) {
        const age = (now - w.t0) / WAVE_MS;
        sources.push({ cx: (w.x - rect.left) / cw, cy: (w.y - rect.top) / ch, k: 1 - age, phase: now / 110 - age * 3 });
      }
      const next = new Set<number>();
      for (const s of sources) {
        const r0 = Math.max(0, Math.floor(s.cy - RADIUS / 2)), r1 = Math.min(ROWS - 1, Math.ceil(s.cy + RADIUS / 2));
        const c0 = Math.max(0, Math.floor(s.cx - RADIUS)), c1 = Math.min(COLS - 1, Math.ceil(s.cx + RADIUS));
        for (let r = r0; r <= r1; r++) for (let c = Math.floor(c0 / SEG); c <= Math.floor(c1 / SEG); c++) next.add(r * segsPerRow + c);
      }
      dirty.forEach((i) => { if (!next.has(i)) restore(i); });
      next.forEach((i) => {
        const s = grid[i];
        if (!s) return;
        const r = Math.floor(i / segsPerRow), c0 = (i % segsPerRow) * SEG;
        let out = "", peak = 0;
        for (let j = 0; j < s.base.length; j++) {
          let bump = 0;
          for (const src of sources) {
            const d = Math.hypot(c0 + j + 0.5 - src.cx, (r + 0.5 - src.cy) * 2);
            if (d >= RADIUS) continue;
            const fall = (1 - d / RADIUS) ** 2;
            bump += Math.round(src.k * fall * AMP * (0.55 + 0.45 * Math.sin(d * 1.3 - src.phase)));
          }
          const base = idx.get(s.base[j]) ?? 0;
          out += ramp[Math.max(0, Math.min(maxIdx, base + bump))];
          peak = Math.max(peak, bump);
        }
        if (out !== s.cur) { s.el.textContent = out; s.cur = out; }
        const lvl = peak >= 3 ? 2 : peak >= 1 ? 1 : 0;
        if (lvl !== s.level) { s.el.classList.toggle("h1", lvl === 1); s.el.classList.toggle("h2", lvl === 2); s.level = lvl; }
      });
      dirty = next;
      raf = requestAnimationFrame(frame);
    }
    const kick = () => { if (!raf && enabled && visible && !hidden) raf = requestAnimationFrame(frame); };

    function measure() { if (!grid.length) build(); rect = pre ? pre.getBoundingClientRect() : null; }
    function onMove(e: PointerEvent) {
      if (e.pointerType === "touch") return;
      measure();
      px = e.clientX; py = e.clientY; lastMove = performance.now(); inside = true; kick();
    }
    function onLeave(e: PointerEvent) { if (e.pointerType !== "touch") { lastMove = performance.now() - DECAY * 0.5; kick(); } }
    function onDown(e: PointerEvent) {
      if (e.pointerType !== "touch") return;
      measure();
      waves.push({ x: e.clientX, y: e.clientY, t0: performance.now() });
      if (waves.length > 3) waves.shift();
      kick();
    }
    function onCancel() { waves = []; restoreAll(); }

    const opts = { passive: true } as AddEventListenerOptions;
    function enable() {
      if (enabled) return;
      enabled = true;
      fig.addEventListener("pointermove", onMove, opts);
      fig.addEventListener("pointerleave", onLeave, opts);
      fig.addEventListener("pointerdown", onDown, opts);
      fig.addEventListener("pointercancel", onCancel, opts);
    }
    function disable() {
      if (!enabled) return;
      enabled = false;
      fig.removeEventListener("pointermove", onMove);
      fig.removeEventListener("pointerleave", onLeave);
      fig.removeEventListener("pointerdown", onDown);
      fig.removeEventListener("pointercancel", onCancel);
      if (raf) cancelAnimationFrame(raf);
      raf = 0; waves = []; inside = false;
      restoreAll();
    }
    const sync = () => (reduce.matches ? disable() : enable());
    reduce.addEventListener("change", sync);
    sync();

    new IntersectionObserver((entries) => {
      visible = entries.some((e) => e.isIntersecting);
      if (!visible) { if (raf) cancelAnimationFrame(raf); raf = 0; restoreAll(); }
    }).observe(fig);
    document.addEventListener("visibilitychange", () => {
      hidden = document.hidden;
      if (hidden) { if (raf) cancelAnimationFrame(raf); raf = 0; restoreAll(); }
    });
    // theme swaps which grid is visible: drop effects on the old one
    document.addEventListener("palette-changed", () => { restoreAll(); grid = []; rect = null; });
    window.addEventListener("resize", () => { rect = null; }, opts);
  }
</script>
