---
import portrait from "../data/ascii-portrait.json";
import peekPortrait from "../data/ascii-portrait-peek.json";
import particles from "../data/portrait-particles.json";
import peekDimensions from "../data/portrait-peek-particles.json";

const SEG = 6;
const esc = (s: string) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
// one span per run of cells that share an opacity level (capped at SEG so hover stays local)
const grid = (g: { chars: string[]; lv: string[] }) =>
  g.chars
    .map((row, y) => {
      const parts: string[] = [];
      let i = 0;
      while (i < row.length) {
        const l = g.lv[y][i];
        let j = i + 1;
        while (j < row.length && j - i < SEG && g.lv[y][j] === l) j++;
        const text = row.slice(i, j);
        parts.push(text.trim() === "" ? esc(text) : `<span class="ap-seg o${parseInt(l, 16)}" data-c="${i}">${esc(text)}</span>`);
        i = j;
      }
      return parts.join("");
    })
    .join("\n");

const sets = [{ id: "peek", variants: peekPortrait.variants }, { id: "loaf", variants: portrait.variants }];
const order = ["desktop", "mobile", "phone"] as const;
---
<figure class="ap" data-ascii-portrait data-aspect={`${particles.w}/${particles.h}`} data-peek-aspect={`${peekDimensions.w}/${peekDimensions.h}`} role="img" aria-label="ASCII portrait of Amber">
  <script is:inline>const portraitFigure = document.currentScript.parentElement;
    // the one and only layout choice: ?p=peek / ?p=loaf force it, anything else is a fresh 50/50 roll on every load
    const forced = new URLSearchParams(location.search).get("p");
    const portraitChoice = forced === "peek" || forced === "loaf" ? forced : Math.random() < 0.5 ? "peek" : "loaf";
    const portraitAspect = portraitChoice === "loaf" ? portraitFigure.dataset.aspect : portraitFigure.dataset.peekAspect;
    portraitFigure.dataset.portraitChoice = portraitChoice;
    portraitFigure.dataset.aspect = portraitAspect;
    portraitFigure.style.setProperty("--portrait-aspect", portraitAspect);
    portraitFigure.classList.add("ap-loading")</script>
  {sets.map((st) => (
    <div class={`ap-set ap-set-${st.id}`}>
      {order.map((k) => (
        <div class={`ap-fit ap-v-${k}`} style={`--cols:${st.variants[k].cols}`}>
          <pre class="ap-grid ap-dark" data-mode="dark" data-cols={st.variants[k].cols} data-rows={st.variants[k].rows} aria-hidden="true" set:html={grid(st.variants[k].dark)} />
          <pre class="ap-grid ap-light" data-mode="light" data-cols={st.variants[k].cols} data-rows={st.variants[k].rows} aria-hidden="true" set:html={grid(st.variants[k].light)} />
        </div>
      ))}
    </div>
  ))}
  <canvas class="ap-canvas" data-ap-canvas width={Math.round(particles.w)} height={particles.h} aria-hidden="true"></canvas>
</figure>

<script>
  import loafUrl from "../data/portrait-particles.json?url";
  import peekUrl from "../data/portrait-peek-particles.json?url";

  type PortraitData = { w: number; h: number; n: number; cellW: number; x: number[]; y: number[]; t: number[]; c: string; a?: number[]; cx?: number; eyeX?: number };

  const fig = document.querySelector<HTMLElement>("[data-ascii-portrait]");
  // the early inline script already made the single choice; never re-roll or re-read the query here
  const isPeek = fig?.dataset.portraitChoice !== "loaf";
  const url = isPeek ? peekUrl : loafUrl;

  const canvas = fig?.querySelector<HTMLCanvasElement>("[data-ap-canvas]");
  const ctx = canvas?.getContext("2d");
  if (fig && canvas && ctx) {
    fetch(url)
      .then((r) => { if (!r.ok) throw new Error("portrait " + r.status); return r.json(); })
      .then((d: PortraitData) => {
        if (!d || !(d.n > 0) || d.x?.length !== d.n) throw new Error("portrait data invalid");
        initPortrait(fig, canvas, ctx, d);
      })
      .catch((e) => {
        console.warn("portrait unavailable", e);
        // the static grid of the chosen layout is revealed; the other layout is never shown
        fig.classList.remove("ap-loading");
      });
  } else fig?.classList.remove("ap-loading");

  function initPortrait(fig: HTMLElement, canvas: HTMLCanvasElement, ctx: CanvasRenderingContext2D, data: PortraitData) {
    const DW = data.w, DH = data.h, N = data.n;
    canvas.height = DH; fig.dataset.aspect = DW + "/" + DH;
    const FONT = Math.round(7 * data.cellW / 4.2 * 10) / 10; // design px; monospace advance is ~0.6em, so 7px sits on the 4.2px cell pitch
    const BUCKETS = [".'`,", "-:~", ";!i*", "+=r1", "ctlI?", "%#oe", "8&@$B"];
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");

    // per-particle state in design coordinates (DW wide; the face centre sits at DW/2)
    const bx0 = Float32Array.from(data.x), bx = Float32Array.from(data.x), by = Float32Array.from(data.y);
    const tone = Float32Array.from(data.t, (v) => v / 255);
    // optional per-particle edge alpha (soft bottom cut); multiplies the final opacity of every palette and of displaced glyphs, so motion never restores the hard edge
    const edge = Float32Array.from(data.a ?? [], (v) => v / 255);
    const hasEdge = edge.length === N;
    const px = new Float32Array(N), py = new Float32Array(N), vx = new Float32Array(N), vy = new Float32Array(N);
    const dens = new Float32Array(N), pick = new Uint8Array(N);
    const tint = new Float32Array(N * 3);
    for (let i = 0; i < N; i++) {
      let h = Math.imul(i + 1, 2654435761) ^ 0x9e3779b9; h = Math.imul(h ^ (h >>> 15), 2246822519); h ^= h >>> 13;
      dens[i] = 5 + ((h >>> 0) % 1600) / 100; // 5..21
      pick[i] = (h >>> 8) & 255;
      for (let k = 0; k < 3; k++) tint[i * 3 + k] = parseInt(data.c[i * 3 + k], 16) * 17;
    }

    // palette-dependent look: glyph, alpha, colour per particle
    let glyph: string[] = new Array(N), alpha = new Float32Array(N), colour: string[] = new Array(N), live = new Uint8Array(N);
    let ink: [number, number, number] = [200, 200, 200], hot: [number, number, number] = [255, 255, 255], accent: [number, number, number] = [255, 180, 80];
    let mono = "monospace", inverse = false, tintAmt = 0.3;
    const rgbOf = (s: string): [number, number, number] => {
      s = s.trim();
      const m = /^#([0-9a-f]{3}|[0-9a-f]{6})$/i.exec(s);
      if (!m) return [200, 200, 200];
      const h = m[1].length === 3 ? [...m[1]].map((c) => c + c).join("") : m[1];
      return [parseInt(h.slice(0, 2), 16), parseInt(h.slice(2, 4), 16), parseInt(h.slice(4, 6), 16)];
    };
    const clamp = (v: number) => (v < 0 ? 0 : v > 255 ? 255 : Math.round(v));
    const css = (c: number[]) => "rgb(" + clamp(c[0]) + "," + clamp(c[1]) + "," + clamp(c[2]) + ")";
    function theme() {
      const cs = getComputedStyle(fig);
      ink = rgbOf(cs.getPropertyValue("--ascii")); hot = rgbOf(cs.getPropertyValue("--text")); accent = rgbOf(cs.getPropertyValue("--accent"));
      mono = cs.getPropertyValue("--mono").trim() || "ui-monospace, Menlo, Consolas, monospace";
      const p = document.documentElement.dataset.palette || (matchMedia("(prefers-color-scheme: dark)").matches ? "ink" : "paper");
      inverse = p === "paper"; // dark ink on light paper: bright tone = sparse glyph
      tintAmt = p === "amber" ? 0.1 : 0.3;
      for (let i = 0; i < N; i++) {
        const t = inverse ? 1 - tone[i] : tone[i];
        if (t < 0.045) { live[i] = 0; continue; }
        live[i] = 1;
        const b = Math.min(BUCKETS.length - 1, Math.floor(t * BUCKETS.length));
        const set = BUCKETS[b];
        glyph[i] = set[pick[i] % set.length];
        alpha[i] = 0.4 + 0.6 * t;
        const r = tint[i * 3], g = tint[i * 3 + 1], bl = tint[i * 3 + 2], l = (r + g + bl) / 3;
        colour[i] = css([ink[0] + tintAmt * (r - l), ink[1] + tintAmt * (g - l), ink[2] + tintAmt * (bl - l)]);
      }
      recentre();
    }
    // centre the DRAWN resting extents (live glyphs with visible edge alpha, plus half a glyph) on data.cx (default the box middle),
    // per palette, because tone culling differs between ink and paper. Base positions only: the pointer never moves the anchor.
    // The shift is clamped so nothing is clipped. Measured via window.__ap.extent() for the browser check.
    let shiftX = 0;
    const HALF = data.cellW * 0.45, VIS = 12 / 255;
    function extent() {
      let mn = Infinity, mx = -Infinity;
      for (let i = 0; i < N; i++) { if (!live[i] || (hasEdge && edge[i] < VIS)) continue; if (bx[i] < mn) mn = bx[i]; if (bx[i] > mx) mx = bx[i]; }
      return { left: mn - HALF, right: mx + HALF };
    }
    function recentre() {
      let mn = Infinity, mx = -Infinity;
      for (let i = 0; i < N; i++) { if (!live[i] || (hasEdge && edge[i] < VIS)) continue; if (bx0[i] < mn) mn = bx0[i]; if (bx0[i] > mx) mx = bx0[i]; }
      if (!(mx >= mn)) return;
      mn -= HALF; mx += HALF;
      const want = (data.cx ?? DW / 2) - (mn + mx) / 2;
      const off = Math.max(-mn, Math.min(DW - mx, want)), d = off - shiftX;
      for (let i = 0; i < N; i++) { bx[i] = bx0[i] + off; px[i] += d; }
      shiftX = off;
    }

    let scale = 1, cssW = 0;
    function resize() {
      const w = Math.max(1, Math.round(canvas.clientWidth));
      const dpr = Math.min(window.devicePixelRatio || 1, 3);
      const bw = Math.round(w * dpr), bh = Math.round(w * DH / DW * dpr);
      if (canvas.width !== bw || canvas.height !== bh) { canvas.width = bw; canvas.height = bh; }
      cssW = w; scale = bw / DW;
    }

    function draw() {
      ctx.setTransform(1, 0, 0, 1, 0, 0);
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      ctx.font = FONT * scale + "px " + mono;
      ctx.textAlign = "center"; ctx.textBaseline = "middle";
      for (let i = 0; i < N; i++) {
        if (!live[i]) continue;
        const dx = px[i] - bx[i], dy = py[i] - by[i], d2 = dx * dx + dy * dy;
        let col = colour[i], a = alpha[i];
        if (d2 > 2) { // displaced glyphs pick up the theme's text/accent colour
          const k = Math.min(1, d2 / 900);
          col = css(k > 0.55 ? accent : hot); a = Math.min(1, a + 0.35 * k + 0.2);
        }
        if (hasEdge) a *= edge[i];
        ctx.globalAlpha = a; ctx.fillStyle = col;
        ctx.fillText(glyph[i], px[i] * scale, py[i] * scale);
      }
      ctx.globalAlpha = 1;
    }

    // physics: damped springs (dt-aware) towards base, pointer adds a repel + swirl force
    const K = 60, C = 12, FORCE = 50, MAXD = 60, MAXD2 = MAXD * MAXD;
    let mx = -9999, my = -9999, raf = 0, last = 0, visible = true, hiddenDoc = document.hidden;
    const radius = () => (window.innerWidth > 768 ? 55 : 75);
    function step(dt: number) {
      const R = radius(), R2 = R * R, near = mx > -9000;
      let moving = false;
      for (let i = 0; i < N; i++) {
        let fx = 0, fy = 0;
        if (near) {
          const ox = px[i] - mx, oy = py[i] - my, d2 = ox * ox + oy * oy;
          if (d2 < R2 && d2 > 0.01) {
            const d = Math.sqrt(d2), nx = ox / d, ny = oy / d, f = (R - d) / R * dens[i] * FORCE;
            fx = f * (nx + 1.5 * ny); fy = f * (ny - 1.5 * nx);
          }
        }
        const dx = px[i] - bx[i], dy = py[i] - by[i];
        vx[i] += (fx - K * dx - C * vx[i]) * dt; vy[i] += (fy - K * dy - C * vy[i]) * dt;
        px[i] += vx[i] * dt; py[i] += vy[i] * dt;
        const nx2 = px[i] - bx[i], ny2 = py[i] - by[i], m2 = nx2 * nx2 + ny2 * ny2;
        if (m2 > MAXD2) { const s = MAXD / Math.sqrt(m2); px[i] = bx[i] + nx2 * s; py[i] = by[i] + ny2 * s; }
        if (m2 > 0.0016 || vx[i] * vx[i] + vy[i] * vy[i] > 0.0016) moving = true;
        else { px[i] = bx[i]; py[i] = by[i]; vx[i] = 0; vy[i] = 0; }
      }
      return moving || near;
    }

        function frame(now: number) {
      raf = 0;
      if (!visible || hiddenDoc) return;
      const dt = Math.min(1 / 30, Math.max(0.001, (now - last) / 1000)); last = now;
      const going = step(dt);
      draw();
      if (going) raf = requestAnimationFrame(frame);
    }
    function kick() { if (!raf && !reduce.matches && visible && !hiddenDoc) { last = performance.now(); raf = requestAnimationFrame(frame); } }
    function stop() { if (raf) cancelAnimationFrame(raf); raf = 0; }
    function settle() { for (let i = 0; i < N; i++) { px[i] = bx[i]; py[i] = by[i]; vx[i] = vy[i] = 0; } mx = my = -9999; }
    function toDesign(e: PointerEvent) {
      const r = canvas.getBoundingClientRect();
      mx = (e.clientX - r.left) / r.width * DW; my = (e.clientY - r.top) / r.height * DH;
    }
    function onMove(e: PointerEvent) { if (reduce.matches) return; toDesign(e); kick(); }
    function onLeave() { mx = my = -9999; kick(); }
    const passive = { passive: true } as AddEventListenerOptions;
    canvas.addEventListener("pointermove", onMove, passive);
    canvas.addEventListener("pointerdown", onMove, passive);
    canvas.addEventListener("pointerup", onLeave, passive);
    canvas.addEventListener("pointercancel", onLeave, passive);
    canvas.addEventListener("pointerleave", onLeave, passive);

    function redraw() { resize(); draw(); }
    new ResizeObserver(() => redraw()).observe(canvas);
    new IntersectionObserver((es) => {
      visible = es.some((e) => e.isIntersecting);
      if (!visible) { stop(); mx = my = -9999; } else { redraw(); kick(); }
    }).observe(canvas);
    const pause = () => { stop(); mx = my = -9999; };
    document.addEventListener("visibilitychange", () => { hiddenDoc = document.hidden; if (hiddenDoc) pause(); else { redraw(); kick(); } });
    window.addEventListener("pagehide", pause);
    document.addEventListener("palette-changed", () => { theme(); redraw(); });
    reduce.addEventListener("change", () => { if (reduce.matches) { stop(); settle(); } redraw(); });
    document.fonts?.ready.then(() => { if (!raf) redraw(); });

    fig.classList.add("ap-js");
    settle(); theme(); resize(); draw();
    fig.classList.remove("ap-loading");
    // test hook for the layout/renderer checks
    (fig as any).__ap = { count: () => N, drawnCount: () => live.reduce((a, b) => a + b, 0), extent, shift: () => shiftX, dw: DW, dh: DH };
  }
</script>
