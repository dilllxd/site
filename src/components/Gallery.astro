---
import { photoDims } from "../lib/images";

interface Props {
  featured?: boolean;
  photos: { id: string; data: { title: string; image: string; alt: string; caption?: string } }[];
}
const { photos, featured = false } = Astro.props;
const dims = await photoDims(photos);
const pool = photos.map((p) => ({ id: p.id, title: p.data.title, caption: p.data.caption ?? "", image: p.data.image, alt: p.data.alt, w: dims[p.id]?.[0], h: dims[p.id]?.[1] }));
const first = pool[0];
---
<div class="gallery-viewer" data-photo-viewer data-photo-viewer-mode="overlay">
  {featured && first && (
    <a href={`/photos/${first.id}/`} class="featured" data-gallery-tile data-featured data-photos={JSON.stringify(pool)} data-title={first.title} data-caption={first.caption} data-image={first.image} data-alt={first.alt} data-w={first.w} data-h={first.h}>
      <span class="featured-media"><img src={first.image} alt={first.alt} width={first.w} height={first.h} decoding="async" fetchpriority="high" data-featured-img /></span>
      <span class="featured-text"><small>Featured</small><strong data-featured-title>{first.title}</strong><span data-featured-caption>{first.caption}</span></span>
    </a>
  )}
  <ul class="gallery">
    {photos.map((photo, i) => (
      <li>
        <a href={`/photos/${photo.id}/`} class="gallery-link" data-gallery-tile data-title={photo.data.title} data-caption={photo.data.caption ?? ""} data-image={photo.data.image} data-alt={photo.data.alt} data-w={dims[photo.id]?.[0]} data-h={dims[photo.id]?.[1]}>
          <img src={photo.data.image} alt={photo.data.alt} width={dims[photo.id]?.[0]} height={dims[photo.id]?.[1]} loading={i < 2 ? "eager" : "lazy"} decoding="async" />
          <span class="gallery-name">{photo.data.title}</span>
        </a>
      </li>
    ))}
  </ul>
  <button type="button" hidden data-photo-viewer-open tabindex="-1" aria-hidden="true"></button>
  <div class="photo-preview" aria-hidden="true" data-photo-viewer-overlay>
    <div class="photo-preview-frame">
      <div class="photo-preview-topline">
        <div class="photo-preview-meta">
          <strong data-gallery-title></strong>
          <span data-gallery-caption></span>
        </div>
        <button type="button" class="photo-preview-close" data-photo-viewer-close aria-label="Close preview">Close</button>
        <div class="photo-preview-actions">
          <div class="photo-preview-zoom">
            <button type="button" data-photo-viewer-zoom-out aria-label="Zoom out">-</button>
            <button type="button" data-photo-viewer-zoom-reset>100%</button>
            <button type="button" data-photo-viewer-zoom-in aria-label="Zoom in">+</button>
          </div>
          <div class="photo-preview-links">
            <a href="#" data-gallery-page>Photo page</a>
            <a href="#" target="_blank" rel="noreferrer" data-gallery-full>Full size</a>
          </div>
        </div>
      </div>
      <div class="photo-preview-viewport" data-photo-viewer-viewport>
        <img src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" alt="" data-photo-viewer-image draggable="false" />
      </div>
    </div>
  </div>
</div>
<script type="module" src="/scripts/photo-viewer.js"></script>
<script>
  const root = document.querySelector(".gallery-viewer");
  if (root) {
    const q = (s) => root.querySelector(s);
    const img = q("[data-photo-viewer-image]");
    const opener = q("[data-photo-viewer-open]");
    const title = q("[data-gallery-title]");
    const caption = q("[data-gallery-caption]");
    const page = q("[data-gallery-page]");
    const full = q("[data-gallery-full]");
    const feat = root.querySelector("[data-featured]");
    if (feat) {
      try {
        const pool = JSON.parse(feat.dataset.photos || "[]");
        if (pool.length > 1) {
          const p = pool[Math.floor(Math.random() * pool.length)];
          const fi = feat.querySelector("[data-featured-img]");
          fi.src = p.image; fi.alt = p.alt;
          if (p.w && p.h) { fi.width = p.w; fi.height = p.h; }
          feat.querySelector("[data-featured-title]").textContent = p.title;
          feat.querySelector("[data-featured-caption]").textContent = p.caption;
          feat.href = "/photos/" + p.id + "/";
          Object.assign(feat.dataset, { title: p.title, caption: p.caption, image: p.image, alt: p.alt, w: p.w ?? "", h: p.h ?? "" });
        }
      } catch (e) { console.warn("[featured] random pick failed", e); }
    }
    root.querySelectorAll("[data-gallery-tile]").forEach((tile) => {
      tile.addEventListener("click", (e) => {
        if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        if (!img || !opener) return;
        e.preventDefault();
        const d = tile.dataset;
        img.src = d.image; img.alt = d.alt || "";
        if (d.w) img.width = +d.w; if (d.h) img.height = +d.h;
        if (title) title.textContent = d.title || "";
        if (caption) caption.textContent = d.caption || "";
        if (page) page.href = tile.getAttribute("href");
        if (full) full.href = d.image;
        tile.focus();
        opener.click();
      });
    });
  }
</script>
