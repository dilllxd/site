---
import { getCollection } from "astro:content";
import SiteLayout from "../layouts/SiteLayout.astro";
import Gallery from "../components/Gallery.astro";
import { siteConfig } from "../data/site";
import { toAbsoluteUrl } from "../lib/seo";

const photos = (await getCollection("photos")).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const widgetConfig = JSON.stringify(siteConfig.widgetConfig);
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Person",
    name: siteConfig.title,
    url: siteConfig.siteUrl,
    email: siteConfig.email,
    homeLocation: {
      "@type": "Place",
      name: siteConfig.location,
    },
    sameAs: siteConfig.socialLinks.map((link) => link.href),
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: siteConfig.siteName,
    url: siteConfig.siteUrl,
    description: siteConfig.description,
    image: toAbsoluteUrl(siteConfig.defaultSocialImage),
  },
];
---
<SiteLayout structuredData={structuredData}>
  <div class="board">
    <div class="board-side">
      <section class="panel about">
        <div class="panel-head"><span><b>01</b> About</span></div>
        <div class="panel-body"><p class="lede">Computer science student. I write code, run my own servers, and photograph nebulae with a small telescope.</p></div>
      </section>

      <section class="panel links">
        <div class="panel-head"><span><b>02</b> Links</span></div>
        <ul class="link-rows">
          <li><a href={`mailto:${siteConfig.email}`}>Email<span>{siteConfig.email}</span></a></li>
          {siteConfig.socialLinks.map((link) => (<li><a href={link.href} target="_blank" rel="noreferrer">{link.label}<span>{new URL(link.href).host.replace(/^www\./, "")}</span></a></li>))}
        </ul>
      </section>

      <section class="panel now home-status" data-widget-config={widgetConfig}>
        <div class="panel-head"><span><b>04</b> Now</span></div>
        <div class="rows status-list">
          <div><span>Local time</span><strong data-local-time>Loading...</strong></div>
          <div data-work-chip><span data-work-label>Schedule</span><strong data-work-status>Checking...</strong></div>
          <div data-discord-chip><span>Discord</span><strong data-discord-status>Connecting...</strong></div>
          <div data-spotify-chip>
            <span>Listening</span><strong data-spotify-status>Waiting for presence data...</strong>
            <div class="spotify-progress" aria-hidden="true"><div data-spotify-progress></div></div>
          </div>
        </div>
      </section>
    </div>

    <Gallery photos={photos} featured />
  </div>

  <script type="module" src="/scripts/live-widgets.js?v=20261010b"></script>
</SiteLayout>
