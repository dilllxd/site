---
import SiteLayout from "../layouts/SiteLayout.astro";
import { siteConfig } from "../data/site";
import { toAbsoluteUrl } from "../lib/seo";

const widgetConfig = JSON.stringify(siteConfig.widgetConfig);
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Person",
    name: siteConfig.title,
    url: siteConfig.siteUrl,
    email: siteConfig.email,
    homeLocation: { "@type": "Place", name: siteConfig.location },
    sameAs: siteConfig.socialLinks.map((link) => link.href),
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: siteConfig.siteName,
    url: siteConfig.siteUrl,
    description: siteConfig.description,
    image: toAbsoluteUrl(siteConfig.defaultSocialImage),
  },
];
const links = [
  { label: "Photos", href: "/photos/", note: "sky globe" },
  { label: "Email", href: `mailto:${siteConfig.email}`, note: siteConfig.email },
  ...siteConfig.socialLinks.map((l) => ({ label: l.label, href: l.href, note: new URL(l.href).host.replace(/^www\./, "") })),
];
---
<SiteLayout structuredData={structuredData} hideFooter={true}>
  <div class="term" data-widget-config={widgetConfig}>
    <p class="term-line"><span class="term-prompt" aria-hidden="true">$</span> ls ~/links</p>
    <ul class="term-links">
      {links.map((l) => (
        <li><a href={l.href} target={l.href.startsWith("http") ? "_blank" : undefined} rel={l.href.startsWith("http") ? "noreferrer" : undefined}>{l.label}<span>{l.note}</span></a></li>
      ))}
    </ul>
    <p class="term-status" data-work-chip><span data-local-time>--:--</span> <span aria-hidden="true">/</span> <span data-work-status>checking schedule</span></p>
  </div>
  <script type="module" src="/scripts/live-widgets.js?v=20261010b"></script>
</SiteLayout>
