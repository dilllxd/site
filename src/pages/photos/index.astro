---
import { getCollection } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { siteConfig } from "../../data/site";
import { toAbsoluteUrl } from "../../lib/seo";

const photos = (await getCollection("photos")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const dims: Record<string, [number, number]> = { "ngc-2244": [2042, 2944], "ngc-2024": [1709, 2472], "m65": [915, 1010], "orion-nebula": [1113, 1920], "ngc-1893": [1107, 1920], "rosette-nebula": [1080, 1920] };
const structuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Photos",
  url: `${siteConfig.siteUrl}/photos/`,
  description:
    "A small gallery of the images I actually want to keep around, with each photo shown in its natural proportions.",
  image: toAbsoluteUrl(siteConfig.defaultSocialImage),
};
---

<SiteLayout
  title="Observing log | Dylan H"
  description="A small gallery of the images I actually want to keep around, with each photo shown in its natural proportions."
  ogImage={siteConfig.defaultSocialImage}
  ogImageAlt={siteConfig.defaultSocialImageAlt}
  structuredData={structuredData}
>
  <header class="page-head">
    <h1>Observing log</h1>
    <p>Each frame is a few hours of stacked exposures from South Carolina, dated and shown at its natural proportions.</p>
  </header>

  <section class="log-archive">
    {photos.map((photo, i) => (
      <figure class={`archive-entry archive-${i % 3}`}>
        <a href={`/photos/${photo.id}/`} class="gallery-link"><img src={photo.data.image} alt={photo.data.alt} width={dims[photo.id]?.[0]} height={dims[photo.id]?.[1]} loading="lazy" decoding="async" /></a>
        <figcaption>
          <span class="plate-no">{photo.data.date.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" })}{photo.data.location ? ` · ${photo.data.location}` : ""}</span>
          <strong><a href={`/photos/${photo.id}/`}>{photo.data.title}</a></strong>
          <span>{photo.data.caption}</span>
        </figcaption>
      </figure>
    ))}
  </section>
</SiteLayout>
