---
import { getCollection } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { siteConfig } from "../../data/site";
import { toAbsoluteUrl } from "../../lib/seo";
import Gallery from "../../components/Gallery.astro";
import SkyStage from "../../components/SkyStage.astro";

const photos = (await getCollection("photos")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const structuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Photos",
  url: `${siteConfig.siteUrl}/photos/`,
  description:
    "An interactive sky atlas of my astrophotography from South Carolina: each photo placed at its real J2000 right ascension and declination, with a plain list of every target.",
  image: toAbsoluteUrl(siteConfig.defaultSocialImage),
};
---

<SiteLayout
  title="Photos | Dylan H"
  description="An interactive sky atlas of my astrophotography from South Carolina: each photo placed at its real J2000 right ascension and declination, with a plain list of every target."
  ogImage={siteConfig.defaultSocialImage}
  ogImageAlt={siteConfig.defaultSocialImageAlt}
  structuredData={structuredData}
>
  <header class="page-head">
    <h1>Photos</h1>
    <p>Stacked exposures from South Carolina, placed at their real RA/Dec.</p>
  </header>

  <Gallery photos={photos}>
    <SkyStage photos={photos} />
  </Gallery>
</SiteLayout>
