---
import { getCollection } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { siteConfig } from "../../data/site";
import { toAbsoluteUrl } from "../../lib/seo";

const posts = (await getCollection("posts")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const structuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Posts",
  url: `${siteConfig.siteUrl}/posts/`,
  description: "Project write-ups, rebuilds, and the occasional longer explanation.",
  image: toAbsoluteUrl(siteConfig.defaultSocialImage),
};
---

<SiteLayout
  title="Posts | Dylan H"
  description="Project write-ups, rebuilds, and the occasional longer explanation."
  ogImageAlt={siteConfig.defaultSocialImageAlt}
  structuredData={structuredData}
>
  <header class="page-head">
    <h1>Writing</h1>
    <p>Project write-ups and rebuilds, written while the details are still fresh.</p>
  </header>

  <section class="writing-section writing-page">
    <ol class="writing-list">
      {posts.map((post) => (
        <li>
          <time class="story-date" datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" })}</time>
          <div>
            <h2><a href={`/posts/${post.id}/`}>{post.data.title}</a></h2>
            <p>{post.data.excerpt}</p>
          </div>
          <span class="inline-meta">{post.data.readingTime}</span>
        </li>
      ))}
    </ol>
  </section>
</SiteLayout>
