{
 "source": "set with ASCII_PORTRAIT_SOURCE or --source; kept outside the repo. Crops are fractions of the auto-oriented upright image (EXIF 8, 2080x2784).",
 "cellAspect": 0.5,
 "ramp": " .-:*+=#%@",
 "levels": 16,
 "minOpacity": 0.55,
 "output": "src/data/ascii-portrait.json",
 "variants": {
  "desktop": {
   "cols": 170,
   "gamma": 0.55,
   "crop": {
    "left": 0,
    "top": 0.1,
    "width": 1,
    "height": 0.86
   }
  },
  "mobile": {
   "cols": 100,
   "gamma": 0.55,
   "crop": {
    "left": 0,
    "top": 0.14,
    "width": 1,
    "height": 0.82
   }
  },
  "phone": {
   "cols": 70,
   "gamma": 0.55,
   "crop": {
    "left": 0.12,
    "top": 0.25,
    "width": 0.88,
    "height": 0.62
   }
  }
 }
}