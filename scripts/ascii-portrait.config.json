{
 "source": "set with ASCII_PORTRAIT_SOURCE or --source; kept outside the repo. Crops are fractions of the auto-oriented upright image (EXIF 6, 3024x4032).",
 "cellAspect": 0.5,
 "ramp": " .-:*+=#%@",
 "levels": 16,
 "minOpacity": 0.55,
 "output": "src/data/ascii-portrait.json",
 "variants": {
  "desktop": {
   "cols": 170,
   "gamma": 1.2,
   "crop": {
    "left": 0.01,
    "top": 0.39,
    "width": 0.77,
    "height": 0.44
   }
  },
  "mobile": {
   "cols": 100,
   "gamma": 1.2,
   "crop": {
    "left": 0.01,
    "top": 0.39,
    "width": 0.77,
    "height": 0.44
   }
  },
  "phone": {
   "cols": 110,
   "gamma": 1.2,
   "crop": {
    "left": 0.01,
    "top": 0.39,
    "width": 0.77,
    "height": 0.44
   }
  }
 },
 "clahe": {
  "tile": 240,
  "slope": 6,
  "mix": 1
 },
 "alphaThreshold": 0.4,
 "catLift": 1,
 "stretch": [
  0.02,
  0.99
 ],
 "sCurve": 0.6,
 "detail": {
  "radius": 3,
  "amount": 1.2
 },
 "particles": {
  "cellW": 3.4,
  "cellH": 5.1
 },
 "faceX": 0.628
}
