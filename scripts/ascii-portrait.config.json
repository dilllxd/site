{
 "source": "set with ASCII_PORTRAIT_SOURCE or --source; kept outside the repo. Crops are fractions of the auto-oriented upright image (EXIF 8, 2080x2784).",
 "cellAspect": 0.5,
 "ramp": " .-:*+=#%@",
 "levels": 16,
 "minOpacity": 0.55,
 "output": "src/data/ascii-portrait.json",
 "variants": {
  "desktop": {
   "cols": 170,
   "gamma": 1.2,
   "crop": {
    "left": 0,
    "top": 0.1,
    "width": 1,
    "height": 0.86
   }
  },
  "mobile": {
   "cols": 100,
   "gamma": 1.2,
   "crop": {
    "left": 0,
    "top": 0.02,
    "width": 1,
    "height": 0.95
   }
  },
  "phone": {
   "cols": 110,
   "gamma": 1.2,
   "crop": {
    "left": 0,
    "top": 0.02,
    "width": 1,
    "height": 0.95
   }
  }
 },
 "clahe": {
  "tile": 160,
  "slope": 6,
  "mix": 1
 },
 "alphaThreshold": 0.4,
 "catLift": 0.6,
 "stretch": [
  0.03,
  0.99
 ],
 "sCurve": 0.6,
 "detail": {
  "radius": 3,
  "amount": 1.2
 }
}